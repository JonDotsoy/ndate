    echo '{{minutes}}\tresult of date.getMinutes()'
    echo '{{seconds}}\tresult of date.getSeconds()'
    echo '{{milliseconds}}\tresult of date.getMilliseconds()'
    echo '{{timezone_offset}}\tresult of date.getTimezoneOffset()'
    echo '{{utc_full_year}}\tresult of date.getUTCFullYear()'
    echo '{{utc_month}}\tUTC month, 1-12'
