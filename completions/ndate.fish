    echo '{{utc}}\tRFC 7231 (alias of rfc7231)'
    echo '{{rfc7231}}\tRFC 7231, e.g. Tue, 08 Aug 2023 03:38:58 GMT'
    echo '{{local}}\tlocale format, same as the default output'
    echo '{{time}}\tresult of date.getTime()'
    echo '{{instant}}\tsame as --instant'
    echo '{{zoned_date_time}}\tsame as --zoned-date-time'
    echo '{{plain_date_time}}\tsame as --plain-date-time'
    echo '{{plain_date}}\tsame as --plain-date'
    echo '{{plain_time}}\tsame as --plain-time'
    echo '{{plain_year_month}}\tsame as --plain-year-month'
    echo '{{plain_month_day}}\tsame as --plain-month-day'
    echo '{{YYYY}}\tyear, 4 digits'
    echo '{{MM}}\tmonth, 2 digits'
    echo '{{DD}}\tday of month, 2 digits'
    echo '{{hh}}\thours, 2 digits (00-23)'
    echo '{{mm}}\tminutes, 2 digits'
    echo '{{ss}}\tseconds, 2 digits'
    echo '{{ms}}\tmilliseconds, 3 digits'
    echo '{{full_year}}\tresult of date.getFullYear()'
    echo '{{month}}\tmonth, 1-12'
    echo '{{date}}\tresult of date.getDate()'
    echo '{{day}}\tday of week, 0 (Sunday) to 6'
