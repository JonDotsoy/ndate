#compdef ndate
#
# zsh completion for ndate
#
# Generated by `ndate completion zsh`. Install: save it as `_ndate` in a
# directory on your $fpath, e.g.
#   mkdir -p ~/.zsh/completions
#   ndate completion zsh > ~/.zsh/completions/_ndate
#   # in ~/.zshrc, before compinit:
#   fpath=(~/.zsh/completions $fpath)
#   autoload -Uz compinit && compinit
# With Homebrew, it can live at "$(brew --prefix)/share/zsh/site-functions/_ndate".
# Or load it in the current session (after compinit):
#   source <(ndate completion zsh)

_ndate_locales() {
  local -a locales
  locales=(${(u)${(f)"$(locale -a 2>/dev/null | sed -n -e 's/^\([a-z][a-z]\)_\([A-Z][A-Z]\).*/\1-\2/p')"}})
  (( ${#locales} )) || locales=(en-US es-CL es-ES en-GB fr-FR de-DE pt-BR ja-JP)
  _describe -t locales 'locale' locales
}

_ndate_template_properties() {
  local -a properties
  properties=(
    'epoch:unix time in seconds'
    'epoch_ms:unix time in milliseconds'
    'json:ISO 8601 (alias of iso8601)'
    'iso:ISO 8601 (alias of iso8601)'
    'iso8601:ISO 8601, e.g. 2023-08-08T03:38:58.570Z'
    'utc:RFC 7231 (alias of rfc7231)'
    'rfc7231:RFC 7231, e.g. Tue, 08 Aug 2023 03:38:58 GMT'
    'local:locale format, same as the default output'
    'time:result of date.getTime()'
    'instant:same as --instant'
    'zoned_date_time:same as --zoned-date-time'
    'plain_date_time:same as --plain-date-time'
    'plain_date:same as --plain-date'
    'plain_time:same as --plain-time'
    'plain_year_month:same as --plain-year-month'
    'plain_month_day:same as --plain-month-day'
    'YYYY:year, 4 digits'
    'MM:month, 2 digits'
    'DD:day of month, 2 digits'
    'hh:hours, 2 digits (00-23)'
    'mm:minutes, 2 digits'
    'ss:seconds, 2 digits'
    'ms:milliseconds, 3 digits'
    'full_year:result of date.getFullYear()'
    'month:month, 1-12'
    'date:result of date.getDate()'
    'day:day of week, 0 (Sunday) to 6'
    'hours:result of date.getHours()'
    'minutes:result of date.getMinutes()'
    'seconds:result of date.getSeconds()'
    'milliseconds:result of date.getMilliseconds()'
    'timezone_offset:result of date.getTimezoneOffset()'
    'utc_full_year:result of date.getUTCFullYear()'
    'utc_month:UTC month, 1-12'
    'utc_date:result of date.getUTCDate()'
    'utc_day:result of date.getUTCDay()'
    'utc_hours:result of date.getUTCHours()'
    'utc_minutes:result of date.getUTCMinutes()'
    'utc_seconds:result of date.getUTCSeconds()'
    'utc_milliseconds:result of date.getUTCMilliseconds()'
    'local_day:"day" part of Intl.DateTimeFormat'
    'local_dayPeriod:"dayPeriod" part of Intl.DateTimeFormat'
    'local_era:"era" part of Intl.DateTimeFormat'
    'local_hour:"hour" part of Intl.DateTimeFormat'
    'local_literal:"literal" part of Intl.DateTimeFormat'
    'local_minute:"minute" part of Intl.DateTimeFormat'
    'local_month:"month" part of Intl.DateTimeFormat'
    'local_second:"second" part of Intl.DateTimeFormat'
    'local_timeZoneName:"timeZoneName" part of Intl.DateTimeFormat'
    'local_weekday:"weekday" part of Intl.DateTimeFormat'
    'local_year:"year" part of Intl.DateTimeFormat'
  )

  # A positional template is written as +<template>, like date +FORMAT.
  compset -P '+'

  # Complete a property after an opening "{{" that is not closed yet.
  if [[ $PREFIX == *'{{'* && ${PREFIX##*'{{'} != *'}}'* ]]; then
    compset -P '*{{'
    _describe -t properties 'template property' properties -S '}}'
  else
    _message -e templates "template, e.g. '{{YYYY}}-{{MM}}-{{DD}}'"
  fi
}

_ndate() {
  # `ndate completion <shell>`
  if [[ $words[2] == completion ]]; then
    (( CURRENT == 3 )) && _values 'shell' bash zsh fish
    return
  fi

  if (( CURRENT == 2 )) && [[ $PREFIX != [-+]* ]]; then
    local -a commands=('completion:print the shell completion script')
    _describe -t commands 'command' commands
  fi

  _arguments -S \
    '-[read the date from stdin]' \
    '(--date -d)'{--date,-d}'[date to format: now or any value accepted by new Date()]:date:(now)' \
    '--date-style[date style of the locale format. Default: full]:date style:(full long medium short none)' \
    '--time-style[time style of the locale format. Default: full]:time style:(full long medium short none)' \
    '--hour-cycles[hour cycle of the locale format, e.g. h23 for 24 hours]:hour cycle:((h11\:"0-11" h12\:"1-12" h23\:"0-23, 24 hours" h24\:"1-24" none))' \
    '(--time-zone -tz)'{--time-zone,-tz}'[IANA time zone, e.g. America/Santiago. Default: $TZ]:time zone:_time_zone' \
    '(--local -l)'{--local,-l}'[locale, e.g. es-CL. Default: $LANG]:locale:_ndate_locales' \
    '--template[render the date with a template (see template properties). Also +<template>]:template:_ndate_template_properties' \
    '(--json -j)'{--json,-j}'[print as ISO 8601, e.g. 2023-08-08T03:38:58.570Z]' \
    '--sheet[print as a spreadsheet formula =DATE()+TIME()]' \
    '--utc[print as RFC 7231, e.g. Tue, 08 Aug 2023 03:38:58 GMT]' \
    '--epoch[print as unix time in seconds]' \
    '--epoch-ms[print as unix time in milliseconds]' \
    '--instant[print as Temporal.Instant, e.g. 2023-08-08T03:38:58.57Z]' \
    '--zoned-date-time[print as Temporal.ZonedDateTime]' \
    '--plain-date-time[print as Temporal.PlainDateTime, e.g. 2023-08-07T23:38:58.57]' \
    '--plain-date[print as Temporal.PlainDate, e.g. 2023-08-07]' \
    '--plain-time[print as Temporal.PlainTime, e.g. 23:38:58.57]' \
    '--plain-year-month[print as Temporal.PlainYearMonth, e.g. 2023-08]' \
    '--plain-month-day[print as Temporal.PlainMonthDay, e.g. 08-07]' \
    '(- *)'{--help,-h}'[show this help]' \
    '(- *)'{--version,-v}'[show the ndate version]' \
    '(--zero -z)'{--zero,-z}'[do not print the final new line]' \
    '--verbose[show the stack trace of errors]' \
    '*:+template:_ndate_template_properties'
}

# Autoloaded from $fpath (the function body runs on first completion), or
# sourced with `source <(ndate completion zsh)` (only register it).
if [[ $funcstack[1] == _ndate ]]; then
  _ndate "$@"
else
  compdef _ndate ndate
fi
